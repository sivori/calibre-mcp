  "license": "GPL-3.0-only",
  "keywords": ["calibre", "ebooks", "books", "reading", "library", "highlights", "research"],
  "icon": "./art/icon-512.png",
  "documentationUrl": "https://github.com/sivori/calibre-mcp#readme",
  "supportUrl": "https://github.com/sivori/calibre-mcp/issues",
  "privacyPolicyUrl": "https://github.com/sivori/calibre-mcp/blob/master/PRIVACY.md",
  "mcpServers": {
    "calibre": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/bridge.py"]
    }
  }
