[
  {
    "name": "library_info",
    "title": "Library overview",
    "description": "Book count, whether full-text search is enabled and how much is indexed, and the annotation count.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search_books",
    "title": "Search books",
    "description": "Search book metadata using calibre search syntax, e.g. \"chess\", \"author:dickens\", \"tags:Fiction and pubdate:<1900\", \"series:true\". An empty query lists every book. Results are sorted by title.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "calibre search expression"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 25
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_book",
    "title": "Get book details",
    "description": "Full metadata for one book: description, publisher, identifiers, languages, custom columns, annotation count.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": "integer"
        }
      },
      "required": [
        "book_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_categories",
    "title": "List categories",
    "description": "Tags, authors, series, publishers or languages in the library, with book counts, most-used first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "tags",
            "authors",
            "series",
            "publisher",
            "languages"
          ],
          "default": "tags"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search_full_text",
    "title": "Search inside books",
    "description": "Search inside the text of the books (calibre full-text search; SQLite FTS5 syntax: words, \"exact phrases\", AND/OR/NOT, prefix*). Returns one highlighted snippet per matching book.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "book_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Only search these books"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "snippet_words": {
          "type": "integer",
          "minimum": 5,
          "maximum": 200,
          "default": 30
        }
      },
      "required": [
        "query"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_passage",
    "title": "Get passage",
    "description": "A longer passage from one book around the first match for the query, for quoting or reading in context.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": "integer"
        },
        "query": {
          "type": "string"
        },
        "words": {
          "type": "integer",
          "minimum": 20,
          "maximum": 200,
          "default": 120
        }
      },
      "required": [
        "book_id",
        "query"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_annotations",
    "title": "Get highlights and notes",
    "description": "Highlights and notes made in the calibre viewer, optionally for one book and/or matching a text query.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": "integer"
        },
        "query": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  }
]
